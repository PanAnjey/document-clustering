# =============================================================================
# Airflow Docker — переменные окружения
# Скопируй в .env и заполни секреты:   cp .env.example .env
# =============================================================================

# UID для файлов, создаваемых контейнером (на Windows можно оставить 50000)
AIRFLOW_UID=50000

# --- Логин в веб-интерфейс Airflow (http://localhost:8080) ---
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# =============================================================================
# Connection: windows_ssh — SSH на Windows-хост, где выполняется реальная работа
# =============================================================================
# Формат URI:  ssh://<user>:<password>@host.docker.internal:22
#   - host.docker.internal — так контейнер видит Windows-хост (Docker Desktop)
#   - спецсимволы в пароле нужно URL-энкодить (@ -> %40, : -> %3A и т.д.)
#
# Пример (пароль "p@ss:1" -> "p%40ss%3A1"):
#   AIRFLOW_CONN_WINDOWS_SSH=ssh://Anjey:p%40ss%3A1@host.docker.internal:22
#
# Лучше — ключевая аутентификация (без пароля в URI). Тогда используй extra с
# ключом, см. airflow_docker/README.md раздел "SSH по ключу".
AIRFLOW_CONN_WINDOWS_SSH=ssh://CHANGE_ME:CHANGE_ME@host.docker.internal:22

# =============================================================================
# Connection: postgres_experiments — PostgreSQL с экспериментальными данными
# (тот же file_organizer_db на Windows-хосте, где лежат documents / gold_stage1 /
#  experiment_registry). Из контейнера доступен через host.docker.internal.
# =============================================================================
# Формат URI: postgresql://<user>:<password>@host.docker.internal:5432/<db>
AIRFLOW_CONN_POSTGRES_EXPERIMENTS=postgresql://postgres:postgres@host.docker.internal:5432/file_organizer_db