export AIRFLOW_HOME=/opt/airflow
export PATH=/opt/airflow-venv/bin:/root/.local/bin:$PATH
export AIRFLOW__CORE__EXECUTOR=LocalExecutor
export AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost/airflow
export AIRFLOW__CORE__LOAD_EXAMPLES=False
export AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
export AIRFLOW__CORE__DAGS_FOLDER=/mnt/d/Yandex.Disk/PYTHON/NLTK/Кластеризация/airflow/dags
export AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.session
